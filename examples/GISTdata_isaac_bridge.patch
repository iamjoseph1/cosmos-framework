+"""GISTdata camera/dish negotiation and responsive policy wait, without Kit."""
+
+import importlib.util
+from pathlib import Path
+import threading
+import time
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import zmq
+
+from isaac_env.bridge.commander import Commander
+from isaac_env.bridge.rb_xhand_replay import ReplayPolicyRollout
+from robot_interface import wire
+from robot_interface.schema.GISTdata.schema import GISTdataSchema
+
+
+@pytest.mark.parametrize("count", [1, 3])
+@pytest.mark.parametrize("dish", ["bowl", "mug"])
+def test_cli_negotiates_actual_cameras_and_dish(count, dish):
+    path = Path(__file__).resolve().parents[1] / "scripts/run/policy/rb_xhand.py"
+    spec = importlib.util.spec_from_file_location("GISTdata_client", path)
+    client = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(client)
+    args = client.build_parser().parse_args(["--dish", dish, "--num-cameras", str(count)])
+    schema = client.policy_schema(args.scenario, num_cameras=args.num_cameras, dish=args.dish)
+    _, _, meta = wire.decode(schema.encode_reset("custom text"))
+    assert meta["dish"] == dish and int(meta["num_cameras"]) == count
+    captures = []
+
+    def camera(name):
+        captures.append(name)
+        return np.full((240, 320, 3), len(captures), dtype=np.uint8)
+
+    rollout = object.__new__(ReplayPolicyRollout)
+    rollout.schema, rollout.camera_names = schema, schema.CAMERA_NAMES
+    rollout.env = SimpleNamespace(
+        get_state=lambda: {"state": np.arange(18, dtype=np.float32)}, get_rgb=camera
+    )
+    obs = rollout.observe()
+    assert tuple(captures) == schema.CAMERA_NAMES
+    _, decoded, _ = wire.decode(schema.encode_obs(obs))
+    assert len(decoded) == count + 1
+    for i, name in enumerate(schema.CAMERA_NAMES):
+        assert np.all(decoded[f"observation.images.{name}"] == i + 1)
+
+
+def test_observation_wait_renders_while_real_zmq_reply_is_pending():
+    context = zmq.Context()
+    sock = context.socket(zmq.REP)
+    sock.setsockopt(zmq.RCVTIMEO, 2000)
+    port = sock.bind_to_random_port("tcp://127.0.0.1")
+    schema = GISTdataSchema(1, "bowl")
+    rendered = []
+
+    def respond():
+        sock.recv()
+        time.sleep(0.05)
+        sock.send(schema.encode_action(np.arange(18, dtype=np.float32)))
+
+    worker = threading.Thread(target=respond)
+    worker.start()
+    client = Commander(
+        schema,
+        port=port,
+        rcv_timeout_ms=1000,
+        while_waiting=lambda: (rendered.append(True), time.sleep(0.001)),
+    )
+    try:
+        arrays = schema.pack_observation(
+            np.zeros(18, dtype=np.float32), {"head": np.zeros((240, 320, 3), dtype=np.uint8)}
+        )
+        action = client.get_action(arrays)
+        np.testing.assert_array_equal(action, np.arange(18, dtype=np.float32))
+        assert rendered
+    finally:
+        client.close()
+        worker.join(timeout=2)
+        sock.close(linger=0)
+        context.term()

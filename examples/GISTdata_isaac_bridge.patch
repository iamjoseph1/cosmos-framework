+"""GISTdata: synchronized RGB, measured state18, absolute joint action18 at 20 Hz."""
+
+import numpy as np
+
+from robot_interface import wire
+from robot_interface.schema.rb_xhand_multitask.schema import FeatureSpec, validate_array
+
+
+class GISTdataSchema:
+    FPS = 20
+    STATE_DIM = ACTION_DIM = ENV_ACTION_DIM = 18
+    OBS_STATE_SPEC = FeatureSpec("observation.state", (18,), "float32")
+    ACTION_SPEC = FeatureSpec("action", (18,), "float32")
+    TASKS = {dish: f"Pick up the red {dish} and place it at the target position." for dish in ("bowl", "mug")}
+    DEFAULT_TASK = TASKS["bowl"]
+
+    def __init__(self, num_cameras=1, dish="bowl"):
+        if num_cameras not in (1, 3):
+            raise ValueError("num_cameras must be 1 or 3")
+        if dish not in self.TASKS:
+            raise ValueError("dish must be bowl or mug")
+        self.num_cameras, self.dish = num_cameras, dish
+        self.CAMERA_NAMES = ("head",) if num_cameras == 1 else ("head", "left_wrist", "right_wrist")
+        self.OBS_IMAGE_SPECS = tuple(
+            FeatureSpec(f"observation.images.{name}", (240, 320, 3), "uint8") for name in self.CAMERA_NAMES
+        )
+        self.OBS_SPECS = (*self.OBS_IMAGE_SPECS, self.OBS_STATE_SPEC)
+
+    def validate_obs(self, arrays):
+        expected = {spec.key for spec in self.OBS_SPECS}
+        if set(arrays) != expected:
+            raise ValueError(f"Expected exactly {sorted(expected)}, got {sorted(arrays)}")
+        for spec in self.OBS_SPECS:
+            validate_array(spec, arrays[spec.key])
+
+    def pack_observation(self, state, images):
+        arrays = {f"observation.images.{name}": np.asarray(images[name]) for name in self.CAMERA_NAMES}
+        arrays[self.OBS_STATE_SPEC.key] = np.asarray(state, dtype=np.float32)
+        self.validate_obs(arrays)
+        return arrays
+
+    def encode_obs(self, arrays):
+        self.validate_obs(arrays)
+        return wire.encode(wire.MessageType.OBS, arrays)
+
+    def encode_reset(self, task=DEFAULT_TASK):
+        return wire.encode(
+            wire.MessageType.RESET,
+            meta={
+                "task": task,
+                "dish": self.dish,
+                "num_cameras": str(self.num_cameras),
+                "schema": "GISTdata_joint18",
+                "fps": str(self.FPS),
+            },
+        )
+
+    def encode_action(self, action):
+        action = np.asarray(action, dtype=np.float32)
+        validate_array(self.ACTION_SPEC, action)
+        return wire.encode(wire.MessageType.ACTION, {self.ACTION_SPEC.key: action})
